[Unit]
Description=Valkey (Redis-compatible) Container
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/valkey/valkey.sh start
ExecStop=/opt/valkey/valkey.sh stop
ExecReload=/opt/valkey/valkey.sh status
RemainAfterExit=true
User=valkey
Group=valkey
TimeoutStartSec=60
TimeoutStopSec=30
Restart=on-failure

[Install]
WantedBy=multi-user.target
